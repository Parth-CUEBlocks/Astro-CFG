---
import Layout from '../layouts/Layout.astro';
import '../styles/services.less';

import { getSeoMetadata } from '../../lib/seo';
import ServiceHeroSection from '../components/servicepage/ServiceHeroSection.astro';
import Serviceblock from '../components/servicepage/Serviceblock.astro';
import ServiceOurApproach from '../components/servicepage/ServiceOurApproach.astro';
import Contactblocks from '../components/Contactblocks.astro';

const { title, description } = await getSeoMetadata(Astro.url.pathname, {
  title: "Shopify Agency for B Corps & Purpose-Driven Brands | CueForGood",
  description: "CueForGood builds Shopify stores for B Corps and purpose-driven brands that prioritize impact and performance. Tailored development, audits, and scalable growth.",
});
---

<Layout title={title} description={description}>
  <div class="cfg-shopify-outer-wrapper service-innerpages shopify-page">
    <div class="cfg-shopify-inner-container">
      <ServiceHeroSection/>
      <ServiceOurApproach/>
      <div class="cfg-services-section">
        <h2 class="cfg-services-title">Our Shopify Services</h2>
        <Serviceblock/>
      </div>
      <Contactblocks color="#eae7ff" title="Ready to Scale Your Mission?" description="Let’s build something good." />

    </div>
  </div>
</Layout>
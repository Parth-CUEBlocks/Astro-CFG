---
import Layout from '../../layouts/Layout.astro';
import '../../styles/shopify.less';

import { getSeoMetadata } from '../../../lib/seo';
import ShopifyHeroSection from '../../components/Shopify/ShopifyHeroSection.astro';
import ShopifyOurApproach from '../../components/Shopify/ShopifyOurApproach.astro';
import Shopifyblock from '../../components/Shopify/Shopifyblock.astro';

const { title, description } = await getSeoMetadata(Astro.url.pathname, {
  title: "Shopify Agency for B Corps & Purpose-Driven Brands | CueForGood",
  description: "CueForGood builds Shopify stores for B Corps and purpose-driven brands that prioritize impact and performance. Tailored development, audits, and scalable growth.",
});
---

<Layout title={title} description={description}>
  <div class="cfg-shopify-outer-wrapper">
    <div class="cfg-shopify-inner-container">
      <ShopifyHeroSection/>
      <ShopifyOurApproach/>

      <!-- OUR SHOPIFY SERVICES SECTION -->
      <section class="cfg-services-section">
        <h2 class="cfg-services-title">Our Shopify Services</h2>

        <Shopifyblock/>

      </section>


    </div>
  </div>
</Layout>
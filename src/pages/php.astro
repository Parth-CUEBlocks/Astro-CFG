---
import Layout from '../layouts/Layout.astro';
import '../styles/shopify.less';

import { getSeoMetadata } from '../../lib/seo';
import PhpHeroSection from '../components/Php/PhpHeroSection.astro';
import PhpOurApproach from '../components/Php/PhpOurApproach.astro';
import Phpblock from '../components/Php/Phpblock.astro';

const { title, description } = await getSeoMetadata(Astro.url.pathname, {
  title: "PHP Development for B Corps & Purpose-Driven Brands | CueForGood ",
  description: "CueForGood builds secure, scalable PHP platforms for B Corps and mission-led organizations. From e-commerce and custom apps to API development and migration, we align tech with your impact.",
});
---

<Layout title={title} description={description}>
  <div class="cfg-shopify-outer-wrapper">
    <div class="cfg-shopify-inner-container">
      <PhpHeroSection/>
      <!-- <PhpOurApproach/>
      <section class="cfg-services-section">
        <Phpblock/>

      </section> -->


    </div>
  </div>
</Layout>
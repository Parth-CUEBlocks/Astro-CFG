---
// src/pages/services.astro
import Layout from '../layouts/Layout.astro';
import '../styles/services.less';


import ServiceHeroSection from '../components/servicepage/ServiceHeroSection.astro';
import Serviceblock from '../components/servicepage/Serviceblock.astro';

import { getSeoMetadata } from '../../lib/seo';

const { title, description } = await getSeoMetadata(Astro.url.pathname, {
  title: "Our Services | CueForGood",
  description: "eCommerce digital agency aligning competence with purpose.",
});
---

<Layout title={title} description={description}>
  <div class="cfg-shopify-outer-wrapper services-page service-order">
    <div class="cfg-shopify-inner-container">
    
    <!-- Hero Section -->
    <ServiceHeroSection/>
    <Serviceblock/>

    <!-- Center Card Contact CTA Banner -->
    <section class="impact-cta-section">
      <div class="container-inner">
        <div class="contactus-area">
          <h2>Make Us Part of the Impact</h2>
          <p>Please <a href="/contact" class="inline-cta-link">share details</a> of your story & project requirements</p>
        </div>
      </div>
    </section>

  </div>
  </div>
</Layout>
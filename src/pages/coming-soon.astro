---
import Layout from '../layouts/Layout.astro';
import '../styles/coming-soon.less';
---

<Layout title="Coming Soon | CueForGood" description="This page is coming soon.">
  <div class="cfg-coming-soon">
    <div class="cfg-coming-soon-inner">
      <span class="cfg-coming-soon-eyebrow">Under Construction</span>
      <h1 class="cfg-coming-soon-heading">This page is coming soon.</h1>
      <p class="cfg-coming-soon-text">
        We're still building this part of the site. In the meantime, head back to the homepage or get in touch with us directly.
      </p>

      <div class="cfg-coming-soon-actions">
        <a href="/" class="cfg-coming-soon-btn cfg-coming-soon-btn-primary focus-visible">Back to Home</a>
        <a href="/contact" class="cfg-coming-soon-btn cfg-coming-soon-btn-secondary focus-visible">Contact Us</a>
      </div>
    </div>
  </div>
</Layout>

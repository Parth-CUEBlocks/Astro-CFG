---
// src/pages/work.astro
import Layout from '../layouts/Layout.astro';
import '../styles/work.less';

// Hero Section Data for the Work Page
import { client } from "../../lib/contentful"; 
const response =await client.getEntries({
  content_type: "teamPageBanners"
});

const data = response.items[0].fields as any;
const ourWorkDesktopBanner = data?.ourWorkDesktopBanner?.fields?.file?.url;
const ourWorkMobileBanner = data?.ourWorkMobileBanner?.fields?.file?.url;

// Meta Title and Description for the Work Page
import { getSeoMetadata } from '../../lib/seo';

const { title, description } = await getSeoMetadata(Astro.url.pathname, {
  title: "CueForGood Case Studies - A Collection of Some of our Work",
  description: "We constantly strive to deliver on our promise of in-depth client collaborations fueled by clear & consistent communication. Take an in-depth look into how we sailed through a few of our projects.",
});

// Case study data for the work page
const response2 = await client.getEntries({
  content_type: "ourWorkPageCaseStudy"
});
const data2 = response2.items;
const portfolioCards1 = (data2 as any[]) || [];
// console.log(portfolioCards1);
---

<Layout title={title} description={description}>
  <section class="work-showcase-page">
    
    <section class="brand-matrix-belt">
      <div class="container-inner">
        {data?.ourWorkTopHeading && <h3>{data?.ourWorkTopHeading}</h3>}
        {data?.ourWorkTopParagraph && <h5>{data?.ourWorkTopParagraph}</h5>}
        <div class="logos-work"> 
          <div class="div-mobile"><img class="" src={`https:${ourWorkMobileBanner}`} alt="client logos in mobile" loading="eager" fetchpriority="high"/></div>
          <div class="div-desktop"><img class="" src={`https:${ourWorkDesktopBanner}`} alt="client logos in desktop" loading="eager" fetchpriority="high"/></div>
        </div>
      </div>
    </section>

    <section class="case-studies-intro">
      <div class="container-inner">
        <div class="intro-split-layout">
          <div class="left-heading-col">
           {data?.ourWorkCaseStudyHeading && <h2>{data?.ourWorkCaseStudyHeading}</h2>}
           {data?.ourWorkCaseStudyParagraphLeft && <p>{data?.ourWorkCaseStudyParagraphLeft}</p>}
          </div>
          <div class="right-context-col">
            {data?.ourWorkCaseStudyParagraphRight && <p>{data?.ourWorkCaseStudyParagraphRight}</p>}
          </div>
        </div>
      </div>
    </section>

    <section class="work-cards-section">
      <div class="container-inner">
        <div class="cards-stack">
          
          {portfolioCards1.map((card, index)=>{
            const tags = card.fields?.tags as any[] || [];
            const postImage = card.fields?.image?.fields?.file?.url;
            return(
            <div class={`project-row-card ${index % 2 === 1 ? 'row-reversed' : ''}`}>
              
              <div class="card-content-side">
                <h2>{card?.fields?.caseStudyTitle}</h2>
                {tags && tags.length > 0 && (
                  <div class="badge-row-container">
                    {tags.map((tag) => (
                      <span class="tech-badge" style="text-transform: uppercase;">{tag}</span>
                    ))}
                  </div>
                )}
                <p class="project-headline-desc">{card?.fields?.description}</p>
                
                <div class="action-btn-wrapper">
                  <a href={card?.fields?.buttonUrl} class="btn-read-more">{card?.fields?.buttonLabel}</a>
                </div>
              </div>

              <div class="card-media-side">
                <div class="image-crop-box">
                  <img src={`https:${postImage}`} alt={card?.fields?.caseStudyTitle} loading="lazy" />
                </div>
              </div>

            </div>
            )
          })}
        </div>
      </div>
    </section>

  </section>
</Layout>

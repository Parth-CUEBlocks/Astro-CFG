---
import Layout from '../layouts/Layout.astro';
import '../styles/cue-for-good.less';

import heroVideo from '../assets/page.cue-for-good/video-cfg.mp4';
import defaultCertLogo from '../assets/page.cue-for-good/b-corp.png';
import cfgPageIcon1 from '../assets/page.cue-for-good/cfg-page-icon1.svg';
import cfgLogo from '../assets/cfg-logo.svg';
import OurClients from '../components/OurClients.astro';

import learningRX from '../assets/page.cue-for-good/learningRX.png';

const certs = [
  {
    id: 'b-corps',
    name: 'B Corp',
    text: 'Certified B Corporations are businesses that meet the highest standards of verified social and environmental performance, public transparency, and legal accountability to balance profit and purpose.'
  },
  {
    id: '1-percent',
    name: '1% for the Planet',
    text: 'Members donate at least 1% of annual sales to environmental non-profits to assist in tackling our planet’s most pressing environmental issues.'
  },
  {
    id: 'climate-neutral',
    name: 'Climate Neutral',
    text: 'Climate Neutral Certified brands measure, reduce, and offset all carbon emissions, taking immediate accountability for their greenhouse gas footprint.'
  },
  {
    id: 'fair-trade',
    name: 'Fair Trade Certified',
    text: 'Fair Trade Certified products ensure sustainable livelihoods, safe working conditions, and fair prices for farmers and workers globally.'
  }
];

const industries = [
  { title: 'Health, Wellness & Nutrition' },
  { title: 'Biohacking' },
  { title: 'Farm to Table' },
  { title: 'Zero Waste' },
  { title: 'Vegan & Cruelty-Free' },
  { title: 'Clean Energy & Environment' },
  { title: 'Ethical & Sustainably sourced products/services' },
  { title: 'Startups with innovative solutions to world problems' }
];

const services = [
  'Shopify',
  'Magento',
  'Woo/WordPress',
  'Core PHP',
  'Creative Design',
  'Organic Search/SEO',
  'Paid Advertising',
  'Content Services',
  'Conversion Rate Optimization',
  'Email Marketing',
  'Analytics'
];

const testimonials = [
  {
    logo: learningRX?.src || cfgPageIcon1.src,
    logoAlt: 'AllThatGrows Logo',
    quote: "“The website design is phenomenal, and customers constantly rave about the packaging and design. Customers also like the functionality, which is something that's helped set our business apart from competitors. Their company is value driven, and their employees and customers come first. I'm very happy with them. Any customer of theirs shouldn't have any trouble. In terms of our PPC and comparison shopping campaigns, they're doing exceptionally well. We're happy with where we're at with them. We're receiving the same high quality deliverables, but at lower rates than those offered in Silicon Valley.”",
    linkText: 'AllThatGrows.in',
    url: 'https://www.allthatgrows.in'
  },
  {
    logo: learningRX?.src || cfgPageIcon1.src,
    logoAlt: 'Badabon Harvest Logo',
    quote: "“I found their pure professionalism and passion for doing what they believe is best for the client to be most impressive. They went above and beyond what we initially thought they'd be doing. I've never seen this level of professionalism in other developers I've worked with. That was very impressive, and I'd recommend them to everyone just for this.”",
    linkText: 'BadabonHarvest.bio',
    url: 'https://badabonharvest.bio'
  },
  {
    logo: learningRX?.src || cfgPageIcon1.src,
    logoAlt: 'LearningRx Logo',
    quote: "“We have worked with CueForGood and have done probably hundreds of projects with them. We have been consistently impressed with their professionalism, reliability, quality of work and extensive expertise in a wide span of technologies and services. LearningRx is a Franchise system with more than 70 Franchised locations, and CueForGood has helped us meet the many demands and challenges of building a technology infrastructure to support multiple locations.\n\nAs we bring new ideas and technology demands to the table, they are consistently able to take on new challenges with ease and expertise. They consistently deliver work on-time, on-budget and with the highest levels of quality.\n\nIn addition, CueForGood is a pleasure to work with as a team—they are friendly, easy to communicate with, highly professional and have the highest level of work ethics and values. I highly recommend CueForGood!.”",
    linkText: 'LearningRx.com',
    url: 'https://www.learningrx.com'
  },
  {
    logo: learningRX?.src || cfgPageIcon1.src,
    logoAlt: 'Ansel & Ivy Logo',
    quote: "“Their technical competence is strong. If you present them with a broad or specific idea around a feature that you want to be developed, they have a keen ability to go and find solutions to that problem. That was refreshing for us because we didn't have the time to go and show them how a feature should be implemented. Their team was able to execute solutions based on our ideas. Overall, we're happy with what CueForGood did. We asked them to build a complex e-commerce platform with a lot of rules. They delivered a product that was not only to specification but also went above and beyond.”",
    linkText: 'AnselAndIvy.com',
    url: 'https://anselandivy.com'
  },
  {
    logo: learningRX?.src || cfgPageIcon1.src,
    logoAlt: 'DAO Labs Logo',
    quote: "“They're a great group to work with for precision, speed, and affordability. They are a tremendous value for what they provide, and they're typically pretty fast. That's why we continue to work with them. Their CEO & founder was very passionate about our company and our product, and there was pretty strong chemistry from that perspective. He was very complimentary of the brand and demonstrated an incredible enthusiasm and motivation to help us achieve our goals.”",
    linkText: 'Mydaolabs.com',
    url: 'https://mydaolabs.com'
  }
];
---

<Layout title="Shopify Agency for B Corps & Purpose-Driven Brands | CueForGood">
  <section class="cue-hero banner_cb" aria-label="Hero">
    <div class="video-container" aria-hidden="true">
      <video autoplay muted loop playsinline class="background-video">
        <source src={heroVideo} type="video/mp4" />
      </video>
      <div class="video-overlay"></div>
    </div>

    <div class="hero-content">
      <h1 class="hero-title">
        <span class="title-top"><strong>CUE</strong> FOR</span>
        <span class="title-bottom">GOOD</span>
      </h1>
      <p class="hero-subtitle">Leveraging eCommerce for purpose</p>

      <span class="scroll-down">
        <a href="#certifications-section" id="first-focus-element" aria-label="Scroll to next section">
          <span class="circle" aria-hidden="true">
            <strong></strong>
          </span>
          Scroll down
        </a>
      </span>
    </div>
  </section>

  <section class="certifications-section" id="certifications-section" tabindex="-1">
    <div class="cert-container">
      <h2 class="cert-heading">eCommerce Agency for brands certified as:</h2>

      <div class="cert-grid" role="tablist" aria-label="Brand Certifications">
        {certs.map((cert, index) => (
          <button
            type="button"
            class={`cert-card ${index === 0 ? 'active' : ''}`}
            role="tab"
            aria-selected={index === 0 ? "true" : "false"}
            aria-controls="cert-detail-panel"
            id={`tab-${cert.id}`}
            data-title={cert.name}
            data-text={cert.text}
          >
            <div class="cert-icon-wrapper">
              <img src={defaultCertLogo.src} alt={cert.name} class="cert-logo" />
            </div>
            <span class="cert-name">{cert.name}</span>
          </button>
        ))}
      </div>

      <div class="cert-detail-box" id="cert-detail-panel" role="tabpanel" aria-labelledby="tab-b-corps" aria-live="polite">
        <h3 class="cert-detail-title" id="cert-detail-title">{certs[0].name}</h3>
        <p class="cert-detail-text" id="cert-detail-text">{certs[0].text}</p>
      </div>

      <hr class="cert-divider" />
    </div>
  </section>

  <section class="ethos-section" aria-label="Our Ethos">
    <div class="ethos-container">
      <h2 class="ethos-heading">
        CueForGood is driven by the ethos of 'service' & making a positive impact in this world.
      </h2>
      <p class="ethos-text">
        As part of the 'Cue for Good' initiative, we consciously work with brands, companies, eCommerce businesses, start-ups as well as purpose-driven organizations that care about making more than just mere profits.
      </p>
    </div>
  </section>

  <section class="industries-section" aria-label="Industries We Serve">
    <div class="industries-container">
      <h2 class="industries-heading">
        We aim to be the wind in the sails of socially-responsible companies that offer products and services in any of the following industries:
      </h2>

      <ul class="industries-grid">
        {industries.map((item) => (
          <li class="industry-item">
            <div class="industry-icon-wrapper">
              <img src={cfgPageIcon1.src} alt="" class="industry-icon" aria-hidden="true" />
            </div>
            <span class="industry-title">{item.title}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="services-section service_weoffer" aria-label="Services We Offer">
    <div class="services-container container">
      <h2 class="heading-cb">Services we offer</h2>
      <h6 class="services-subtitle">
        Empowering the altruists to have a greater impact by leveraging digital & eCommerce
      </h6>
      <p class="services-intro">
        As an eCommerce Agency, we offer the following areas of expertise.
      </p>

      <div class="services-content-wrapper">
        <div class="services-logo-col">
          <img src={cfgLogo.src} alt="Cue for Good Logo" class="services-logo" />
        </div>
        
        <div class="services-main-content">
          <ul class="services-grid services-inn-cb">
            {services.map((service) => (
              <li class="service-item">{service}</li>
            ))}
          </ul>

          <div class="contactus-area btm-cont">
            <h2 class="heading-cb">Please share details of your story & project requirements</h2>
            <a href="#contact" class="contactus-btn">Contact us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <OurClients/>

  <section class="testimonials-section" aria-label="Client Testimonials">
    <div class="testimonials-container">
      <h2 class="heading-cb">Client Testimonials</h2>
      <h6 class="testimonials-subtitle">Some good words</h6>

      <div class="testimonials-grid">
        {testimonials.map((item) => (
          <div class="test-block">
            <div class="client-logo-wrapper">
              <img src={item.logo} alt={item.logoAlt} class="client-logo" />
            </div>
            <p class="quote-text">{item.quote}</p>
            {item.linkText && (
              <a href={item.url} target="_blank" rel="noopener noreferrer" class="client-link">
                {item.linkText}
              </a>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<script>
  const certButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.cert-card'));
  const detailTitle = document.getElementById('cert-detail-title');
  const detailText = document.getElementById('cert-detail-text');
  const detailPanel = document.getElementById('cert-detail-panel');

  function activateTab(btn: HTMLButtonElement) {
    certButtons.forEach((b) => {
      b.classList.remove('active');
      b.setAttribute('aria-selected', 'false');
      b.setAttribute('tabindex', '-1');
    });

    btn.classList.add('active');
    btn.setAttribute('aria-selected', 'true');
    btn.setAttribute('tabindex', '0');
    btn.focus();

    const title = btn.getAttribute('data-title');
    const text = btn.getAttribute('data-text');

    if (detailTitle && title) detailTitle.textContent = title;
    if (detailText && text) detailText.textContent = text;
    if (detailPanel && btn.id) detailPanel.setAttribute('aria-labelledby', btn.id);
  }

  certButtons.forEach((btn, index) => {
    btn.addEventListener('click', () => activateTab(btn));

    btn.addEventListener('keydown', (e: KeyboardEvent) => {
      let targetIndex = index;

      if (e.key === 'ArrowRight') {
        targetIndex = (index + 1) % certButtons.length;
      } else if (e.key === 'ArrowLeft') {
        targetIndex = (index - 1 + certButtons.length) % certButtons.length;
      } else if (e.key === 'Home') {
        targetIndex = 0;
      } else if (e.key === 'End') {
        targetIndex = certButtons.length - 1;
      } else {
        return;
      }

      e.preventDefault();
      activateTab(certButtons[targetIndex]);
    });
  });
</script>
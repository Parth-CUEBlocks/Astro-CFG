---

import { client } from "../../lib/contentful";

let data: any[] = [];
try {
  const response = await client.getEntries({
    content_type: "footerPartnerLogo"
  });
  data = response.items;
} catch (error) {
  console.error("footer-carousel Contentful fetch error:", error);
}

const logolist = (data as any[]) || [];
---
 <div class=" partners-swiper">
      <div class="swiper-wrapper elements-align-center">
        {logolist.map((item) => {
          // Extract data from individual reference items
          const url = item.fields?.partnerLogoUrl;
          const width = item.fields?.width;
          const mobWidth = item.fields?.mobWidth;
          const websiteLogo = item.fields?.partnerLogo?.fields?.file?.url;
          const websiteLogoalt = item.fields?.partnerLogo?.fields?.title;
          const logoStyle = `--partner-logo-width: ${width}px; --partner-logo-mob-width: ${mobWidth ?? width}px;`;

          return (
            <div class="swiper-slide partner-logo shopify">
              { url ?
                  <a href={url} target="_blank">
                   <img src={`https:${websiteLogo}`} alt={websiteLogoalt} loading="lazy" style={logoStyle} />
                   </a>
                   :
                   <img src={`https:${websiteLogo}`} alt={websiteLogoalt} loading="lazy" style={logoStyle} />
                }


            </div>
          );
        })}

      </div>
      <div class="swiper-pagination"></div>
    </div>

<script>
  import '../scripts/swiper.js'; 
</script>
<style>
  .partner-logo img{
    max-height: 76px;
    width: var(--partner-logo-width, auto);
    max-width: 180px;
  }

  @media (max-width: 767px) {
    .partner-logo img {
      width: var(--partner-logo-mob-width, var(--partner-logo-width, auto));
    }
  }

  /* Dots stay hidden on desktop, shown at tablet/mobile — matches the original site */
  .partners-swiper .swiper-pagination {
    display: none;
  }

  @media (max-width: 991px) {
    .partners-swiper .swiper-pagination {
      display: block;
      position: static;
      width: 100%;
      text-align: center;
      margin-top: 16px;
    }
  }
</style>
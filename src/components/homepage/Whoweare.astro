---
import Homepagecarousal from './Homepagecarousal.astro';
import { client } from "../../../lib/contentful"; 
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';

const response = await client.getEntries({
  content_type: "homepageHeroBanner"
});

const data = response.items[0]?.fields;

// Instead of mapping over an array, convert the whole rich text block into HTML string
const whatWeDoServiceBlock = data?.whatWeDoServiceBlock ? documentToHtmlString(data.whatWeDoServiceBlock as any)  : "";
const whoWeAreDescription = data?.whoWeAreDescription ? documentToHtmlString(data.whoWeAreDescription as any)  : "";
// console.log(data);
---

<section class="cfg-overview-viewport">
    <div class="cfg-overview-container">
      
      <div class="cfg-overview-column">
        <h2 class="cfg-overview-heading">{data?.whatWeDoHeading}</h2>
        <p class="cfg-overview-lead">
         {data?.whatWeDoBelowHeadingDescription}
        </p>

        <div class="cfg-services-group">
            {/* This will automatically render your headings (<h2>, <h3>), paragraphs, and lists */}
            <div class="cfg-rich-text-content" set:html={whatWeDoServiceBlock} />
        </div>
      </div>

      <div class="cfg-overview-column">
        <h2 class="cfg-overview-heading right">{data?.whoWeAreHeading}</h2>
        <div class="cfg-profile-description" set:html={whoWeAreDescription} />

        <div class="cfg-slider-system">
          <Homepagecarousal/>
        </div>
      </div>

    </div>
</section>
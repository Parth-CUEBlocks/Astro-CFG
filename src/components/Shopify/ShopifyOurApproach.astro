---
// src/components/Testimonials.astro
import { client } from "../../../lib/contentful";
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';

let data1: any[] = [];
try {
  const responsetitle = await client.getEntries({
    content_type: "ourApproachTitleShopifyPage"
  });
  data1 = responsetitle.items;
} catch (error) {
  console.error("ShopifyOurApproach (title) Contentful fetch error:", error);
}

let data: any[] = [];
try {
  const response = await client.getEntries({
    content_type: "ourApproachShopifyPage"
  });
  data = response.items;
} catch (error) {
  console.error("ShopifyOurApproach Contentful fetch error:", error);
}

const approach = (data as any[]) || [];
---
      <section class="cfg-approach-section">

        <div class="main-heading text-center">
          <h2 class="cfg-section-heading">{data1[0]?.fields?.title}</h2>
          <p>{data1[0]?.fields?.description}</p>
        </div>

        <div class="cfg-approach-grid">
          {approach.map((item)=>{
            const title = item.fields?.heading;
            const Image = item.fields?.image as any;
            const ImageURL = Image?.fields?.file?.url;
            const description = item.fields?.description ? documentToHtmlString(item.fields.description as any)  : "";
            
            return(
              <div class="cfg-approach-card">
                <div class="cfg-approach-icon">
                  <img src={`https:${ImageURL}`} alt={title} class="showcase-img" loading="lazy"  />
                </div>
                <h3>{title}</h3>
                <div class="description-data"  set:html={description} />
            </div>
            )
          })}

        </div>
      </section>



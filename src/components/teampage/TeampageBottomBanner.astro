---
import {client} from "../../../lib/contentful";

let data: any = undefined;
try {
  const response = await client.getEntries({
    content_type: "teamPageBanners"
  });
  data = response.items[0]?.fields;
} catch (error) {
  console.error("TeampageBottomBanner Contentful fetch error:", error);
}

const desktopImageUrl = data?.bottomBannerDesktop?.fields?.file?.url;
const mobileImageUrl = data?.bottomBannerMobile?.fields?.file?.url;

---
    <section class="team-banner team-banner-bottom">
      {desktopImageUrl && <img class="desk-h" src={`https:${desktopImageUrl}`} alt="CueForGood team group picture" loading="lazy" />}
      {mobileImageUrl && <img class="mob" src={`https:${mobileImageUrl}`} alt="CueForGood team group picture for mobile" loading="lazy" />}
    </section>

    
  
---
import {client} from "../../../lib/contentful";

let data: any = undefined;
try {
  const response = await client.getEntries({
    content_type: "teamPageBanners"
  });
  data = response.items[0]?.fields;
} catch (error) {
  console.error("TeampageTopbanners Contentful fetch error:", error);
}

const desktopImageUrl = data?.topBannerDesktop?.fields?.file?.url;
const mobileImageUrl = data?.topBannerMobile?.fields?.file?.url;

---


    <section class="team-banner">
      {desktopImageUrl && <img class="desk-h" src={`https:${desktopImageUrl}`} alt="CueForGood team picture" loading="eager" fetchpriority="high" />}
      {mobileImageUrl && <img class="mob" src={`https:${mobileImageUrl}`} alt="CueForGood team picture for mobile" loading="eager" fetchpriority="high" />}
    </section>
  
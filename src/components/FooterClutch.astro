---

import { client } from "../../lib/contentful"; 

const response = await client.getEntries({
  content_type: "homepageHeroBanner" 
});

const data = response?.items[0]?.fields as any;
 const url = data?.footerClutchUrl;
const imageUrl = data?.footerClutchImage?.fields?.file?.url;
//  console.log(data);
---
        {imageUrl &&
        <div class="fixed-clutch" >
          <a href={url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="CueForGood profile on Clutch (opens in a new tab)"
            class="focus-visible">
            <img src={`https:${imageUrl}`} alt="CueForGood profile on Clutch" />

          </a>
        </div>
        }
<style>
.fixed-clutch { 
  position: fixed;
  bottom: 10px;
  right: 10px;
  z-index: 9;
}
</style>

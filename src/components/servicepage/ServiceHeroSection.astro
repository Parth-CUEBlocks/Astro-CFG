---
import { client } from "../../../lib/contentful"; 
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';

const rawPath = Astro.url.pathname;
const currentUrl = rawPath.replace(/\/$/, '') || '/';

const response = await client.getEntries({
  content_type: "shopifyPageTopSection",
  'fields.pageUrl': currentUrl,
});


const data = response.items[0]?.fields;
//  console.log(data);
// Instead of mapping over an array, convert the whole rich text block into HTML string
const topSectionParagraph1 = data?.topSectionParagraph1 ? documentToHtmlString(data.topSectionParagraph1 as any)  : "";
const topSectionParagraph2 = data?.topSectionParagraph2 ? documentToHtmlString(data.topSectionParagraph2 as any)  : "";
const Image = data?.topSectionImage as any;
const ImageURL = Image?.fields?.file?.url;
const Labelimg = data?.serviceLabelImage as any;
const LabelimgURL = Labelimg?.fields?.file?.url;
---
      {data?.heading &&
      <section class="cfg-shopify-hero">
        <div class="cfg-hero-grid">
          <div class="cfg-hero-content">
            <div class="flex-hero"><h1 class="cfg-hero-title">{data?.heading}</h1>
              {LabelimgURL && <img src={`https:${LabelimgURL}`} alt="shopify logo"/>}
            </div>
            <h2 class="cfg-hero-subtitle">{data?.subHeading}</h2>
            <div class="cfg-hero-desc" set:html={topSectionParagraph1} />
            {data?.buttonLabel && 
            <a id="first-focus-element" class="btn main_cta focus-visible" href={`${data?.buttonUrl}`}>{data?.buttonLabel}</a>
            }
            
          </div>
          <div class="cfg-hero-media">
            {ImageURL && <img src={`https:${ImageURL}`} alt="Shopify Expert & Certifications Graphic" class="cfg-hero-total-img" loading="eager" fetchpriority="high" />}
          </div>

        </div>
        {topSectionParagraph2  && <div class="ethical_Organizations " set:html={topSectionParagraph2} />}
       

      </section>
      }

      

  

  
---
import { client } from "../../../lib/contentful";
import { documentToHtmlString } from '@contentful/rich-text-html-renderer';

let data: any = undefined;
try {
  const response = await client.getEntries({
    content_type: "servicePageTopSection"
  });
  data = response.items[0]?.fields;
} catch (error) {
  console.error("ServiceHeroSection Contentful fetch error:", error);
}
// console.log(data);
// Instead of mapping over an array, convert the whole rich text block into HTML string
const topSectionParagraph1 = data?.topSectionParagraph1 ? documentToHtmlString(data.topSectionParagraph1 as any)  : "";
const Image = data?.topSectionImage as any;
const ImageURL = Image?.fields?.file?.url;
---

  <section class="services-hero">
      <div class="container-inner">
        <div class="hero-split-grid">
          <div class="hero-text-col">
            <h1>{data?.heading}</h1>
            <div class="hero-lead" set:html={topSectionParagraph1} />
            
            <div class="intro-philosophy">
              <h2>{data?.subHeading}</h2>
              <p>{data?.topSectionParagraph2}</p>
            </div>
          </div>
          
          <div class="hero-graphic-col">
            <div class="hero-image-field">
              <img src={`https:${ImageURL}`} alt="Isometric Cubes Representation Graphic" class="page-hero-img" loading="eager" fetchpriority="high" />
            </div>
          </div>
        </div>

        <div class="pillar-block">
          <p class="hero-focus">{data?.heroBelowSectionParagraph1}</p>
          <h2 class="pillar-main-statement">{data?.heroBelowSectionHeading}</h2>
          <p class="pillar-subtext">{data?.heroBelowSectionParagraph2}</p>
        </div>
      </div>
  </section>
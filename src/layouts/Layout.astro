---
// src/layouts/Layout.astro
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

// Import your decoupled Less style sheets
import '../styles/base.less';
import '../styles/header.less';
import '../styles/footer.less';
import '../../public/fonts/fonts.css';



const { title = "CueForGood | eCommerce Agency for Impact Brands" } = Astro.props;
const { description = "eCommerce digital agency aligning competence with purpose." } = Astro.props;
import favicon from '../assets/favicon.ico';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href={favicon} />
		
		<meta name="generator" content={Astro.generator} />
		

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Montserrat:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
	</head>
	<body>
		<a href="#main-content" class="skip-to-content-anchor">Skip To Content</a>

		<Header />

		<main id="main-content" tabindex="-1">
			<slot />
		</main>

		<Footer />
		<script> 
			function handleResponsiveElements() {
			if (window.innerWidth > 768) {
				document.querySelectorAll('.div-mobile').forEach(element => element.remove());
			} else {
				document.querySelectorAll('.div-desktop').forEach(element => element.remove());
			}
			}

			document.addEventListener('DOMContentLoaded', handleResponsiveElements);
			window.addEventListener('resize', handleResponsiveElements);
		</script>
	</body>
</html>

<style is:global>
	

	/* For body text, paragraphs, and UI elements */
	
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	.skip-to-content-anchor {
		position: fixed;
		top: 10px;
		left: 10px;
		z-index: 10000;
		background: #000;
		color: #fff;
		padding: 14px 8px;
		min-height: 44px;
		height: 44px;
		display: flex;
		align-items: center;
		border: 1px solid #000;
		font-size: 12px;
		line-height: 1;
		text-decoration: none;
		transform: translateY(-100px);
		transition: transform 0.3s;
	}

	.skip-to-content-anchor:focus {
		transform: translateY(0%);
		outline: 2px solid #e7a743;
		outline-offset: 4px;
	}

	main:focus {
		outline: none;
	}
</style>